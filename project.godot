[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="interactable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

environment/ssao/quality=1
environment/ssao/half_size=true

anti_aliasing/quality/msaa_3d=2
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.6
anti_aliasing/screen_space_roughness_limiter/limit=0.6

[gui]

theme/custom="res://assets/ui/game_theme.tres"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/return_value_discarded=0

[shader_globals]

